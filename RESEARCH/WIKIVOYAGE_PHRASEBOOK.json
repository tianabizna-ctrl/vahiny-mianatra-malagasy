lish", "en": "Do you speak English?", "mg": "Miteny anglisy ve ianao?", "say": ""}, {"id": "wv_anyone_english", "en": "Is there someone here who speaks English?", "mg": "Misy olona miteny anglisy ve ato?", "say": ""}, {"id": "wv_help", "en": "Help!", "mg": "Vonjeo!", "say": ""}, {"id": "wv_lookout", "en": "Look out!", "mg": "Masiaka!", "say": "Mash-YUCK"}, {"id": "wv_goaway", "en": "Go away!", "mg": "Mandehana!", "say": "man-day-HAN"}, {"id": "wv_goodmorning", "en": "Good morning", "mg": "Salama e", "say": ""}, {"id": "wv_goodevening", "en": "Good evening", "mg": "Salama", "say": ""}, {"id": "wv_goodnight_to_sleep", "en": "Good night (to sleep)", "mg": "Tafandria mandry", "say": ""}, {"id": "wv_dontunderstand", "en": "I don't understand", "mg": "Tsy azoko", "say": ""}, {"id": "wv_where_toilet", "en": "Where is the toilet?", "mg": "Aiza ny toilety?", "say": "Aizuh twal-YET-ee"}, {"id": "wv_thereis", "en": "There is", "mg": "misy", "say": "mees"}, {"id": "wv_nothing", "en": "Nothing, not", "mg": "tsy", "say": ""}, {"id": "wv_nothing_reply", "en": "I don't have anything (reply to beggars)", "mg": "Tsy misy", "say": "tsee-mees"}, {"id": "wv_whoareyou", "en": "Who are you?", "mg": "Iza moa ianao?", "say": ""}, {"id": "wv_Iam", "en": "I am ___", "mg": "Izaho no/dia ___", "say": ""}, {"id": "wv_beware_dog", "en": "Beware of dog", "mg": "Alika masiaka", "say": "a-LEEK-ya mash-YUK"}, {"id": "wv_dead_end", "en": "Dead end", "mg": "Tsy azo aleha", "say": ""}, {"id": "wv_do_not_enter", "en": "Do not enter", "mg": "Tsy azo idirana", "say": ""}, {"id": "wv_zone_secured", "en": "Zone under security", "mg": "Toerana voaaro", "say": ""}, {"id": "wv_no_smoking", "en": "No smoking", "mg": "Tsy azo ifohana sigara", "say": ""}, {"id": "wv_respect_clean", "en": "Respect the cleanness", "mg": "Hajao ny fahadiovana", "say": ""}, {"id": "wv_phone_hello", "en": "Hello! (on the phone)", "mg": "Allô!", "say": ""}, {"id": "wv_who_is_it", "en": "Who is it please?", "mg": "Iza io azafady?", "say"