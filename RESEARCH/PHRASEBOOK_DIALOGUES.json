{
  "meta": {
    "title": "Vahiny Mianatra Malagasy — Survival Phrasebook & Dialogues",
    "description": "The sentence and dialogue layer that pairs with VOCAB_THEMATIC.json. Phrases are grouped by real situation and ordered along the 12-week curriculum, each with a model mini-dialogue. Sources: Peace Corps Malagasy Language Lessons (public domain) and bako.blog lessons (used as reference for this original compilation).",
    "version": "1.0",
    "audience": "Elderly American beginner learner (absolute beginner, English speaker)"
  },
  "conventions": {
    "fields": {
      "id": "stable slug, unique within the group",
      "mg": "official Malagasy",
      "mg_tsm": "Tsimihety variant (only when it differs)",
      "en": "English meaning",
      "when_to_say": "the exact situation to use the phrase (optional)",
      "note": "grammar or culture explanation (optional)"
    },
    "vos_warning": "Malagasy sentence order is VERB + OBJECT + SUBJECT: 'Mihinana vary aho' = lit. 'Eats rice I'. The phrases are safe to learn as WHOLE CHUNKS while the structure clicks into place later.",
    "pronunciation_reminders": [
      "a = FATHER, e = MADE, i = KEEP, o = POOL; final -y sounds like 'ee'.",
      "Stress the NEXT-TO-LAST syllable: mi-SO-tro (drink), ve-LO-ma (goodbye).",
      "No c, q, u, w, x in the Malagasy alphabet."
    ]
  },
  "groups": [
    {
      "id": "greet_and_farewell",
      "title": "Greeting & Saying Goodbye",
      "curriculum_week": [
        1
      ],
      "peace_corps_audio": [
        "MG_Malagasy_Lesson_2.mp3"
      ],
      "bako_lessons": [
        "intro 1a",
        "intro 1b"
      ],
      "phrases": [
        {
          "id": "greet_hello",
          "mg": "Salama!",
          "en": "Hello!",
          "note": "Works any time of day, to anyone."
        },
        {
          "id": "greet_polite",
          "mg": "Salama tompoko!",
          "en": "Hello, sir/ma'am!",
          "note": "The all-purpose polite greeting (most common in Mandritsara)."
        },
        {
          "id": "greet_howareyou",
          "mg": "Manao ahoana?",
          "en": "How are you?",
          "mg_tsm": "Manakory?",
          "note": "Official; Tsimihety: 'Manakory?'"
        },
        {
          "id": "greet_health",
          "mg": "Fahasalamana?",
          "en": "How are you? (after your health)",
          "when_to_say": "Meeting someone you know, or an older person."
        },
        {
          "id": "greet_reply",
          "mg": "Tsara fa misaotra.",
          "en": "I'm fine, thank you.",
          "note": "The standard reply. Fa = but: 'fine BUT (only) thanks to you.'"
        },
        {
          "id": "greet_whatsnew",
          "mg": "Inona ny vaovao?",
          "en": "What's new?",
          "mg_tsm": "Ino vaovao?",
          "when_to_say": "Right after the how-are-you exchange."
        },
        {
          "id": "greet_nonew",
          "mg": "Tsy misy vaovao.",
          "en": "Nothing's new.",
          "mg_tsm": "Tsisy vaovao.",
          "note": "The modest standard answer."
        },
        {
          "id": "greet_frontdoor",
          "mg": "Haody!",
          "en": "Hello! (at the door)",
          "when_to_say": "Arriving at someone's house and you can't see them — like knocking."
        },
        {
          "id": "greet_comein",
          "mg": "Mandrosoa!",
          "en": "Come in!",
          "note": "Said by the host; also 'come and buy' at a market stall."
        },
        {
          "id": "greet_sit",
          "mg": "Mipetrapetraha!",
          "en": "Have a seat!"
        },
        {
          "id": "fare_bye",
          "mg": "Veloma!",
          "en": "Goodbye!",
          "when_to_say": "Leaving; the one going says veloma."
        },
        {
          "id": "fare_safe",
          "mg": "Soava dia!",
          "en": "Safe travels!",
          "note": "Replied by the person staying behind: 'soa am-bifilana' = safe return!"
        },
        {
          "id": "fare_seeyou",
          "mg": "Mandrapihaona!",
          "en": "See you later!",
          "note": "Same day or next day."
        },
        {
          "id": "fare_seeyou_soon",
          "mg": "Rehefa avy eo!",
          "en": "See you in a bit!",
          "note": "When you'll meet again the same day."
        },
        {
          "id": "fare_tomorrow",
          "mg": "Veloma rahampitso koa!",
          "en": "See you tomorrow!",
          "mg_tsm": "Amarainy koa!"
        },
        {
          "id": "fare_enjoy",
          "mg": "Mazotoa!",
          "en": "Enjoy! / have a good day!",
          "note": "A versatile goodbye: before someone eats, rests, or works."
        },
        {
          "id": "greet_meal",
          "mg": "Mazotoa homana!",
          "en": "Enjoy your meal!",
          "mg_tsm": "Mazotoa homana",
          "when_to_say": "Someone heads off to eat; reply 'Misaotra ianao koa.'"
        }
      ],
      "dialogue": {
        "title": "A visit to a friend's house (Bako intro 1a)",
        "lines": [
          {
            "speaker": "You",
            "mg": "Haody!",
            "en": "Hello! (calling at the door)"
          },
          {
            "speaker": "Host",
            "mg": "Mandrosoa. Mipetrapetraha.",
            "en": "Come in. Have a seat."
          },
          {
            "speaker": "You",
            "mg": "Salama tompoko.",
            "en": "Hello, sir/ma'am."
          },
          {
            "speaker": "Host",
            "mg": "Salama tompoko. Manakory ianao?",
            "en": "Hello. How are you?"
          },
          {
            "speaker": "You",
            "mg": "Tsara fa misaotra.",
            "en": "Fine, thank you."
          },
          {
            "speaker": "Host",
            "mg": "Ino vaovao?",
            "en": "What's new?"
          },
          {
            "speaker": "You",
            "mg": "Tsisy vaovao.",
            "en": "Nothing's new."
          }
        ]
      }
    },
    {
      "id": "polite_words",
      "title": "Politeness — Essential 'Please' Words",
      "curriculum_week": [
        1
      ],
      "peace_corps_audio": [
        "MG_Malagasy_Lesson_2.mp3"
      ],
      "bako_lessons": [
        "intro 2"
      ],
      "phrases": [
        {
          "id": "pol_thanks",
          "mg": "Misaotra!",
          "en": "Thank you!"
        },
        {
          "id": "pol_thanks_big",
          "mg": "Misaotra betsaka.",
          "en": "Thank you very much."
        },
        {
          "id": "pol_welcome_reply",
          "mg": "Tsisy fisaorana.",
          "en": "Not at all / don't mention it."
        },
        {
          "id": "pol_please",
          "mg": "Azafady!",
          "en": "Please / excuse me / sorry / pardon",
          "note": "The single most useful word in Malagasy politeness."
        },
        {
          "id": "pol_pass",
          "mg": "Azafady, aiza ianao?",
          "en": "Excuse me, may I get by?",
          "when_to_say": "Squeezing past someone — on a taxi-brousse, at the market."
        },
        {
          "id": "pol_go_ahead",
          "mg": "Ndao.",
          "en": "Go ahead / after you."
        },
        {
          "id": "pol_sorry",
          "mg": "Miala tsiny!",
          "en": "Sorry! (for a slip)",
          "note": "Also in the Peace Corps lesson; azafady covers most apologies."
        },
        {
          "id": "pol_no_problem",
          "mg": "Tsy maninona.",
          "en": "No problem / you're welcome."
        },
        {
          "id": "pol_invitation",
          "mg": "Mandrosoa!",
          "en": "Come and join us! (to a meal)",
          "when_to_say": "Whenever you pass people eating — they MUST invite you; you may politely decline."
        },
        {
          "id": "pol_decline_meal",
          "mg": "Misaotra, mazotoa.",
          "en": "Thanks, enjoy yours.",
          "note": "The graceful decline to a meal invitation."
        },
        {
          "id": "pol_enough",
          "mg": "Ampy izay!",
          "en": "That's enough, thank you!",
          "when_to_say": "Being served food or buying at the market."
        },
        {
          "id": "pol_softener",
          "mg": "Mba ...",
          "en": "(softener) please, just ...",
          "note": "Put 'mba' before a request to soften it: 'Mba omeo rano aho azafady.'"
        }
      ],
      "dialogue": {
        "title": "Passing politely (Bako intro 2)",
        "lines": [
          {
            "speaker": "You",
            "mg": "Azafady, aiza ianao?",
            "en": "Excuse me, may I get by?"
          },
          {
            "speaker": "Other",
            "mg": "Ndao.",
            "en": "Go ahead."
          },
          {
            "speaker": "You",
            "mg": "Misaotra.",
            "en": "Thank you."
          }
        ]
      }
    },
    {
      "id": "introducing_yourself",
      "title": "Introducing Yourself",
      "curriculum_week": [
        2
      ],
      "peace_corps_audio": [
        "MG_Malagasy_Lesson_3.mp3"
      ],
      "bako_lessons": [
        "intro 3"
      ],
      "phrases": [
        {
          "id": "intro_name_q",
          "mg": "Iza no anaranao?",
          "en": "What is your name?",
          "note": "Lit. 'who is your name?'"
        },
        {
          "id": "intro_name_a",
          "mg": "___ no anarako.",
          "en": "My name is ___.",
          "mg_tsm": "Anarako ___."
        },
        {
          "id": "intro_and_you",
          "mg": "... ary ianao?",
          "en": "... and you?",
          "note": "Add to the end of any self-introduction fact."
        },
        {
          "id": "intro_pleased",
          "mg": "Faly mahalala anao!",
          "en": "Pleased to meet you!",
          "mg_tsm": "Faly mandray anao!",
          "note": "Reply: 'Faly mahalala anao koa!'"
        },
        {
          "id": "intro_from_q",
          "mg": "Avy aiza ianao?",
          "en": "Where are you from?"
        },
        {
          "id": "intro_from_a",
          "mg": "Avy any Etazonia aho.",
          "en": "I'm from the United States."
        },
        {
          "id": "intro_city",
          "mg": "Avy any ___ aho.",
          "en": "I'm from ___.",
          "note": "Insert your city: 'Avy any Boston aho.'"
        },
        {
          "id": "intro_job_q",
          "mg": "Inona ny asanao?",
          "en": "What do you do (for work)?"
        },
        {
          "id": "intro_job_a",
          "mg": "Mpiofana aho.",
          "en": "I'm a trainee.",
          "note": "Swap the job word: mpampianatra (teacher), mpivarotra (merchant)..."
        },
        {
          "id": "intro_learn",
          "mg": "Mianatra teny malagasy aho.",
          "en": "I'm learning Malagasy.",
          "note": "THE sentence of this whole course!"
        },
        {
          "id": "intro_speak_q",
          "mg": "Miteny malagasy ve ianao?",
          "en": "Do you speak Malagasy?"
        },
        {
          "id": "intro_speak_a",
          "mg": "Kely fotsiny.",
          "en": "Just a little.",
          "note": "The humble answer everyone loves to hear."
        },
        {
          "id": "intro_stay_q",
          "mg": "Hipetraka aiza ianao?",
          "en": "Where will you stay?"
        },
        {
          "id": "intro_lives_q",
          "mg": "Mipetraka aiza ianao?",
          "en": "Where do you live?"
        },
        {
          "id": "intro_live_a",
          "mg": "Mipetraka eto Antananarivo aho.",
          "en": "I live here in Antananarivo."
        },
        {
          "id": "intro_marry_q",
          "mg": "Manambady ve ianao?",
          "en": "Are you married?"
        },
        {
          "id": "intro_marry_a",
          "mg": "Manambady aho. / Tsy manambady aho.",
          "en": "I'm married. / I'm not married.",
          "mg_tsm": "Manambady zaho."
        },
        {
          "id": "intro_kids",
          "mg": "Manana zanaka ___ aho.",
          "en": "I have ___ (number) children.",
          "note": "Or: 'Mananjanaka zahay' = we (exclusive) have children."
        },
        {
          "id": "intro_kids_detail",
          "mg": "Mananjanaka telo zahay: lahy iray, vavy roa.",
          "en": "We have three children: one boy, two girls.",
          "mg_tsm": "Mananjanaka telo zahay: lalahy iray, vaiavy roa."
        },
        {
          "id": "intro_seeyou",
          "mg": "Mandrapihaona!",
          "en": "See you later!"
        }
      ],
      "dialogue": {
        "title": "Meeting a new friend (Peace Corps L3 + Bako intro 3)",
        "lines": [
          {
            "speaker": "A",
            "mg": "Salama tompoko! Manao ahoana?",
            "en": "Hello! How are you?"
          },
          {
            "speaker": "B",
            "mg": "Tsara fa misaotra. Iza no anaranao?",
            "en": "Fine, thanks. What is your name?"
          },
          {
            "speaker": "A",
            "mg": "Mary no anarako, ary ianao?",
            "en": "My name is Mary, and you?"
          },
          {
            "speaker": "B",
            "mg": "Raiko aho. Faly mahalala anao!",
            "en": "I'm Raiko. Pleased to meet you!"
          },
          {
            "speaker": "A",
            "mg": "Faly mahalala anao koa! Avy aiza ianao?",
            "en": "Pleased to meet you too! Where are you from?"
          },
          {
            "speaker": "B",
            "mg": "Avy any Etazonia aho.",
            "en": "I'm from the United States."
          },
          {
            "speaker": "A",
            "mg": "Miteny malagasy ve ianao?",
            "en": "Do you speak Malagasy?"
          },
          {
            "speaker": "B",
            "mg": "Kely fotsiny!",
            "en": "Just a little!"
          }
        ]
      }
    },
    {
      "id": "market_shopping",
      "title": "At the Market — Shopping",
      "curriculum_week": [
        3,
        12
      ],
      "peace_corps_audio": [
        "MG_Malagasy_Lesson_9.mp3"
      ],
      "bako_lessons": [
        "intro 4"
      ],
      "phrases": [
        {
          "id": "mkt_hello",
          "mg": "Haody!",
          "en": "Hello! (calling for the vendor)",
          "when_to_say": "You arrive at a stall and see no one — call haody!"
        },
        {
          "id": "mkt_comebuy",
          "mg": "Mandroso!",
          "en": "Come and buy!",
          "note": "The vendor's call to you; 'Mandrosoa' — go ahead and browse."
        },
        {
          "id": "mkt_have_q",
          "mg": "Misy ___ ve?",
          "en": "Do you have ___?",
          "note": "THE shopping question: 'Misy atody ve?' = Are there eggs?"
        },
        {
          "id": "mkt_have_yes",
          "mg": "Ia, misy.",
          "en": "Yes, there are.",
          "mg_tsm": "Ia, misy."
        },
        {
          "id": "mkt_have_no",
          "mg": "Tsisy.",
          "en": "There aren't / we're out.",
          "mg_tsm": "Tsisy."
        },
        {
          "id": "mkt_price_q",
          "mg": "Ohatrinona ity?",
          "en": "How much is this?",
          "mg_tsm": "Ohatrino ity?",
          "note": "For several items: 'Ohatrinona ireto?' = how much are these?"
        },
        {
          "id": "mkt_price_a",
          "mg": "Fitonjato (ariary).",
          "en": "Seven hundred (ariary).",
          "note": "Number answer, right-to-left: fito + jato = 700."
        },
        {
          "id": "mkt_give_me",
          "mg": "Omeo telo azafady.",
          "en": "Give me three, please.",
          "mg_tsm": "Amezo telo azafady.",
          "note": "Give me + number: omeo dimy / omeo folo..."
        },
        {
          "id": "mkt_give_cups",
          "mg": "Omeo telo kapoaka azafady.",
          "en": "Give me three cups (of rice), please.",
          "note": "Measure after number: kapoaka (cup), toko (pile), kilao (kilo), litatra (litre)."
        },
        {
          "id": "mkt_expensive",
          "mg": "Lafo be!",
          "en": "That's very expensive!",
          "note": "Polite banter, expect the back-and-forth to follow!"
        },
        {
          "id": "mkt_cheap_plz",
          "mg": "Mora azafady!",
          "en": "Cheap it down, please! / give me a better price!"
        },
        {
          "id": "mkt_change",
          "mg": "Tsy misy madinika.",
          "en": "There's no change.",
          "mg_tsm": "Tsisy la monnaie.",
          "note": "Vendor apology when you hand over a big bill."
        },
        {
          "id": "mkt_enough",
          "mg": "Ampy izay, misaotra!",
          "en": "That's all, thank you!"
        }
      ],
      "dialogue": {
        "title": "Buying eggs at the market (Bako intro 4)",
        "lines": [
          {
            "speaker": "You",
            "mg": "Haody!",
            "en": "Hello! (anybody here?)"
          },
          {
            "speaker": "Vendor",
            "mg": "Mandroso!",
            "en": "Come in / come and buy!"
          },
          {
            "speaker": "You",
            "mg": "Salama tompoko.",
            "en": "Hello."
          },
          {
            "speaker": "Vendor",
            "mg": "Salama tompoko.",
            "en": "Hello."
          },
          {
            "speaker": "You",
            "mg": "Misy atody ve?",
            "en": "Are there any eggs?"
          },
          {
            "speaker": "Vendor",
            "mg": "Ia, misy.",
            "en": "Yes, there are."
          },
          {
            "speaker": "You",
            "mg": "Ohatrino(na)?",
            "en": "How much are they?"
          },
          {
            "speaker": "Vendor",
            "mg": "Fitonjato.",
            "en": "700 (ariary)."
          },
          {
            "speaker": "You",
            "mg": "Amezo telo azafady.",
            "en": "Give me three, please."
          },
          {
            "speaker": "Vendor",
            "mg": "Azafady, tsisy madinika.",
            "en": "Sorry, no change."
          }
        ]
      }
    },
    {
      "id": "basic_needs",
