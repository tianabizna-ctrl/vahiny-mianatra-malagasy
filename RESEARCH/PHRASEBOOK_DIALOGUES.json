        },
        {
          "id": "time_at_hour",
          "mg": "Amin'ny telo maraina.",
          "en": "At three in the morning.",
          "note": "Formula: amin'ny + number + time-of-day. Evening hours after sunset count from the evening!"
        },
        {
          "id": "time_at_3pm",
          "mg": "Amin'ny telo tolakandro.",
          "en": "At three in the afternoon."
        },
        {
          "id": "time_at_6pm",
          "mg": "Amin'ny enina hariva.",
          "en": "At six in the evening."
        },
        {
          "id": "time_noon",
          "mg": "Mitataovovonana.",
          "en": "It's noon.",
          "note": "Lit. 'the sun sits on the ridge of the roof' — lovely!"
        },
        {
          "id": "time_midnight",
          "mg": "Misasakalina.",
          "en": "It's midnight."
        },
        {
          "id": "time_meet_when",
          "mg": "Oviana isika no hihaona?",
          "en": "When shall we meet?"
        },
        {
          "id": "time_meet_fri",
          "mg": "Hihaona amin'ny Zoma amin'ny efatra isika.",
          "en": "We'll meet Friday at four.",
          "note": "The Week 8 goal sentence!"
        },
        {
          "id": "time_today_tom",
          "mg": "Androany / Rahampitso.",
          "en": "Today / tomorrow.",
          "note": "omaly = yesterday: the essential time trio."
        },
        {
          "id": "time_what_do_q",
          "mg": "Inona no nataonao omaly?",
          "en": "What did you do yesterday?",
