      ],
      "dialogue": {
        "title": "A hot afternoon (Peace Corps L6)",
        "lines": [
          {
            "speaker": "You",
            "mg": "Mangetaheta aho!",
            "en": "I'm thirsty!"
          },
          {
            "speaker": "Host",
            "mg": "Manandrosoa! Misotro kafe.",
            "en": "Come in! Have some coffee."
          },
          {
            "speaker": "You",
            "mg": "Misaotra betsaka!",
            "en": "Thank you very much!"
          }
        ]
      }
    },
    {
      "id": "eating_ordering",
      "title": "Eating & Ordering Food",
      "curriculum_week": [
        5
      ],
      "peace_corps_audio": [
        "MG_Malagasy_Lesson_10.mp3"
      ],
      "bako_lessons": [
        "theme 4",
        "theme 8a"
      ],
      "phrases": [
        {
          "id": "eat_have_rice_q",
          "mg": "Misy vary ve?",
          "en": "Is there rice? / do you have rice?",
          "note": "A Malagasy NEEDS to know!"
        },
        {
          "id": "eat_i_eat",
          "mg": "Mihinana vary aho.",
          "en": "I eat rice.",
          "note": "The model VOS sentence: verb + object + subject."
        },
        {
          "id": "eat_i_dont",
          "mg": "Tsy mihinana hena aho.",
          "en": "I don't eat meat.",
          "when_to_say": "Declining a dish politely."
        },
        {
          "id": "eat_would_like",
          "mg": "Te hihinana ___ aho.",
          "en": "I would like to eat ___."
        },
        {
          "id": "eat_delicious",
          "mg": "Matsiro be!",
          "en": "Very delicious!",
          "when_to_say": "Always say this — it makes the cook's day."
        },
        {
          "id": "eat_enough",
          "mg": "Ampy izay, misaotra!",
          "en": "That's enough for me, thank you!",
          "when_to_say": "Being served more food than you can eat — which will happen!"
        },
        {
          "id": "eat_full",
          "mg": "Voky aho, misaotra!",
          "en": "I'm full, thank you!",
          "note": "A prized skill at a Malagasy table: knowing when to say voky."
        },
        {
          "id": "eat_ask_water",
          "mg": "Mila rano amin'ny tavoahangy aho.",
          "en": "I'd like bottled water.",
          "note": "A wise health choice for a visitor."
        },
        {
          "id": "eat_ask_coffee",
          "mg": "Kaopy kafe iray azafady.",
          "en": "One cup of coffee, please."
        },
        {
          "id": "eat_breakfast",
          "mg": "Misakafo maraina aho.",
          "en": "I'm having breakfast.",
          "note": "Lunch: misakafo atoandro; dinner: misakafo hariva."
        },
        {
          "id": "eat_where_kitchen",
          "mg": "Aiza ny lakozia?",
          "en": "Where is the kitchen?"
        },
        {
          "id": "eat_point",
          "mg": "Tondroy ny ___.",
          "en": "Point to the ___.",
          "note": "TPR lesson drill: tondroy ny latabatra = point to the table."
        },
        {
          "id": "eat_pass_plz",
          "mg": "Omeo ny sira azafady.",
          "en": "Pass the salt, please."
        },
        {
          "id": "eat_spicy_q",
          "mg": "Mahery ve ity?",
          "en": "Is this (chili) hot?",
          "note": "ASK BEFORE YOU TASTE. Sakay is seriously hot!"
        },
        {
          "id": "eat_spicy_a",
          "mg": "Tsara be! Tsy mahery.",
          "en": "It's great! Not hot."
        }
      ],
      "dialogue": {
        "title": "Being urged to eat more (every Malagasy table!)",
        "lines": [
          {
            "speaker": "Host",
            "mg": "Mandrosoa! Misakafo isika!",
            "en": "Come! Let's eat!"
          },
          {
            "speaker": "You",
            "mg": "Misaotra betsaka! Matsiro be ity laoka ity.",
            "en": "Thank you very much! This laoka is delicious."
          },
          {
            "speaker": "Host",
            "mg": "Hihinana bebebebe kokoa!",
            "en": "Have some more! (urge-urge-urge)"
          },
          {
            "speaker": "You",
            "mg": "Ampy izay! Voky aho, misaotra!",
            "en": "That's enough! I'm full, thank you!"
          },
          {
            "speaker": "Host",
            "mg": "Mazotoa!",
            "en": "Enjoy!"
          }
        ]
      }
    },
    {
