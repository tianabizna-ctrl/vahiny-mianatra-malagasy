      "curriculum_week": [
        4
      ],
      "peace_corps_audio": [
        "MG_Malagasy_Lesson_6.mp3"
      ],
      "bako_lessons": [],
      "phrases": [
        {
          "id": "need_hungry",
          "mg": "Noana aho.",
          "en": "I'm hungry."
        },
        {
          "id": "need_thirsty",
          "mg": "Mangetaheta aho.",
          "en": "I'm thirsty."
        },
        {
          "id": "need_full",
          "mg": "Voky aho.",
          "en": "I'm full.",
          "note": "Gracious reply at a Malagasy table where you are urged to keep eating!"
        },
        {
          "id": "need_tired",
          "mg": "Reraka aho.",
          "en": "I'm tired."
        },
        {
          "id": "need_hot",
          "mg": "Mafana aho.",
          "en": "I'm hot."
        },
        {
          "id": "need_cold",
          "mg": "Mangatsiaka aho.",
          "en": "I'm cold."
        },
        {
          "id": "need_want_drink",
          "mg": "Te hisotro rano aho.",
          "en": "I want to drink water.",
          "note": "Pattern: te + h-verb = want to ..."
        },
        {
          "id": "need_want_eat",
          "mg": "Te hisakafo aho.",
          "en": "I want to eat."
        },
        {
          "id": "need_want_sleep",
          "mg": "Te hatory aho.",
          "en": "I want to sleep."
        },
        {
          "id": "need_want_out",
          "mg": "Te hivoaka aho.",
