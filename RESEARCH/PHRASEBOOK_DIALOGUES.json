          },
          {
            "speaker": "Local",
            "mg": "Tsy lavitra. Mianatsimo, avy eo miankavanana.",
            "en": "Not far. Go south, then turn right."
          },
          {
            "speaker": "You",
            "mg": "Misaotra betsaka!",
            "en": "Thank you very much!"
          },
          {
            "speaker": "Local",
            "mg": "Tsisy fisaorana.",
            "en": "Not at all."
