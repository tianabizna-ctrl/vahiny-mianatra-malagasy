          "en": "I don't like meat."
        },
        {
          "id": "feel_happy",
          "mg": "Faly izy.",
          "en": "He/she is happy."
        },
        {
          "id": "feel_sad",
          "mg": "Malahelo aho.",
          "en": "I'm sad."
        },
        {
          "id": "feel_surprised",
          "mg": "Gaga aho.",
          "en": "I'm surprised."
        },
        {
          "id": "feel_afraid",
          "mg": "Matahotra aho.",
          "en": "I'm afraid / scared."
        },
        {
          "id": "feel_trust",
          "mg": "Matoky anao aho.",
          "en": "I trust you."
        },
        {
          "id": "feel_hate",
          "mg": "Halako ity.",
          "en": "I hate this/it.",
          "note": "halako = its-hate: the possessive suffix carries the object!"
